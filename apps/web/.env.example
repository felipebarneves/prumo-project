# Copie para .env.local e preencha com valores reais. NUNCA commite o
# .env.local preenchido (já coberto pelo .gitignore deste app).

# Supabase — Project Settings > API. A anon key é pública por design (protegida
# por RLS no banco), mas ainda assim não deve ser hardcoded no código-fonte.
NEXT_PUBLIC_SUPABASE_URL=https://<seu-projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Stripe — Developers > API keys (chave publicável, começa com pk_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<stripe-publishable-key>

# URL base da API FastAPI (apps/api). Em desenvolvimento local aponta para o
# uvicorn local; em produção, aponte para o domínio do deploy da API na Vercel
# (ver docs/deploy.md — modo "dois projetos", a estratégia recomendada).
NEXT_PUBLIC_API_URL=http://localhost:8000
