# Copie para .env e preencha com valores reais. NUNCA commite o .env preenchido
# (já coberto pelo .gitignore da raiz do monorepo).

# Supabase — Project Settings > API
SUPABASE_URL=https://<seu-projeto>.supabase.co
# Service role key: acesso total, contorna RLS. Usada pelo backend para aplicar
# regras de negócio (limites de plano, gate de assinatura) que RLS não expressa
# — ver apps/api/app/modules/viabilidade/repository.py. NUNCA exponha esta
# chave no frontend nem em logs.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Stripe — Developers > API keys / Webhooks
STRIPE_SECRET_KEY=<stripe-secret-key>
STRIPE_WEBHOOK_SECRET=<stripe-webhook-signing-secret>
